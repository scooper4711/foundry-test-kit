{
  "name": "@scooper4711/foundry-test-kit",
  "version": "0.1.0",
  "description": "Playwright integration testing for Foundry VTT modules: server lifecycle, world seeding, Gamemaster and player sessions, and end-to-end coverage.",
  "keywords": [
    "foundryvtt",
    "foundry-vtt",
    "playwright",
    "e2e",
    "integration-testing"
  ],
  "license": "MIT",
  "author": "Stephen Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scooper4711/foundry-test-kit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "foundry-test": "bin/foundry-test",
    "foundry-test-coverage": "dist/coverage/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build && (husky || true)",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "dependencies": {
    "convert-source-map": "^2.0.0",
    "dotenv": "^17.4.2",
    "nyc": "^18.0.0",
    "v8-to-istanbul": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
